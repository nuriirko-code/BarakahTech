# Server
PORT=5000
NODE_ENV=development
# Database
MONGO_URI=mongodb://localhost:27017/barakah-academy

# Authentication
JWT_SECRET=your_strong_random_secret_here_minimum_32_characters
JWT_EXPIRE=30d

# Frontend
FRONTEND_URL=http://localhost:5173

# Email (Resend)
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=noreply@barakah-academy.com

# Payment
PLATFORM_COMMISSION_PERCENTAGE=20

# Platform Payment Accounts
TELEBIRR_NUMBER=your_telebirr_number
CBE_ACCOUNT=your_cbe_account
SUPPORT_EMAIL=nuriirko@gmail.com

# Live video provider. LiveKit is currently the implemented provider adapter.
LIVE_PROVIDER=livekit
# LiveKit-compatible endpoint credentials (set these before enabling live rooms)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVE_JOIN_EARLY_MINUTES=15
LIVE_GRACE_MINUTES=30
